{
  "name": "ai-xmp-tagger-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "capture:social": "node scripts/capture-social-card.mjs",
    "capture:social:check": "node scripts/capture-social-card.mjs --check",
    "test:content": "node --test tests/content.test.mjs",
    "test:release": "node --test tests/release-integrity.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run capture:social:check && npm run test:content && npm run test:release && npm run test:e2e",
    "test:ci-repository": "node scripts/test-ci-repository.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "7.3.6"
  }
}
