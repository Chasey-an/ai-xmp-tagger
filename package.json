{
  "name": "ai-xmp-tagger-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "capture:social": "node scripts/capture-social-card.mjs",
    "test:content": "node --test tests/content.test.mjs",
    "test:release": "node --test tests/release-integrity.test.mjs",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test": "npm run build && npm run test:content && npm run test:release && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "7.3.6"
  }
}
